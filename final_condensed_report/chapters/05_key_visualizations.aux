\newlabel{chap:visualizations}{{5}{15}{Key Visualizations and Representative Trajectories}{chapter.5}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.1}The Baseline PPO Trajectory in Fixed Climates}{15}{section.5.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces Diagnostics Panel for the defining PPO run under Fixed Weather. The episode lengths quickly saturate to the physical maximum, while training rewards strictly adhere to a monotonically increasing limit curve. The primary metric showcases an aggressively optimized, nearly monotonic climb to convergence.}}{16}{figure.caption.12}\protected@file@percent }
\newlabel{fig:representative_fixed_ppo}{{5.1}{16}{Diagnostics Panel for the defining PPO run under Fixed Weather. The episode lengths quickly saturate to the physical maximum, while training rewards strictly adhere to a monotonically increasing limit curve. The primary metric showcases an aggressively optimized, nearly monotonic climb to convergence}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.2}The Drought Crash Phenomenon}{17}{section.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces The 'Drought Crash' Phenomenon visible in Episode Length progression. Despite an otherwise climbing optimization curve, injected multi-year historical droughts physically break the carrying capacity of the environment, causing sudden precipitous drops in sequence lengths. Agents relying heavily on zero-entropy exploration are most vulnerable to these shocks.}}{17}{figure.caption.13}\protected@file@percent }
\newlabel{fig:drought_crash}{{5.2}{17}{The 'Drought Crash' Phenomenon visible in Episode Length progression. Despite an otherwise climbing optimization curve, injected multi-year historical droughts physically break the carrying capacity of the environment, causing sudden precipitous drops in sequence lengths. Agents relying heavily on zero-entropy exploration are most vulnerable to these shocks}{figure.caption.13}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.3}Catastrophic Over-Fertilization (Economic Misweighting)}{17}{section.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Catastrophic Over-Fertilization timeline. Notice the intensely dense activation graph indicating the agent actively 'panic-spraying' inputs. While yielding densely populated crop structures, the economic efficiency fundamentally collapsed under realistic constraints.}}{18}{figure.caption.14}\protected@file@percent }
\newlabel{fig:over_fertilization}{{5.3}{18}{Catastrophic Over-Fertilization timeline. Notice the intensely dense activation graph indicating the agent actively 'panic-spraying' inputs. While yielding densely populated crop structures, the economic efficiency fundamentally collapsed under realistic constraints}{figure.caption.14}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.4}A2C Volatility under Hierarchical Constraints}{18}{section.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.4}{\ignorespaces A2C Evaluation Checkpoint Curve. Notice the intense parameter oscillation and massive variance bands, indicating volatile learning jumps that periodically regress the agent far below optimal state values prior to rebounding.}}{18}{figure.caption.15}\protected@file@percent }
\newlabel{fig:a2c_volatility}{{5.4}{18}{A2C Evaluation Checkpoint Curve. Notice the intense parameter oscillation and massive variance bands, indicating volatile learning jumps that periodically regress the agent far below optimal state values prior to rebounding}{figure.caption.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces The hierarchical crop decision timeline generated by the A2C run mapped physically against internal phase transitions. Despite volatility, the final sequence successfully honors structural sequence laws.}}{19}{figure.caption.16}\protected@file@percent }
\newlabel{fig:a2c_hierarchy}{{5.5}{19}{The hierarchical crop decision timeline generated by the A2C run mapped physically against internal phase transitions. Despite volatility, the final sequence successfully honors structural sequence laws}{figure.caption.16}{}}
